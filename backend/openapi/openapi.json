{
  "openapi": "3.0.3",
  "info": {
    "title": "Novara API",
    "version": "1.0.0",
    "description": "Novara cafe and restaurant management API."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "accessCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "novara_access"
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Create a user, tenant, first branch, and owner membership",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 320,
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 72,
                    "pattern": "[A-Za-z]"
                  },
                  "businessName": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 160
                  },
                  "branchName": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password",
                  "businessName",
                  "branchName"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account and workspace created; session cookies set.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "name": {
                              "type": "string"
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "platformRole": {
                              "type": "string",
                              "nullable": true,
                              "enum": [
                                "SUPER_ADMIN",
                                "SUPPORT_AGENT",
                                null
                              ]
                            },
                            "isPlatformAdmin": {
                              "type": "boolean"
                            },
                            "memberships": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "format": "uuid"
                                  },
                                  "role": {
                                    "type": "string",
                                    "enum": [
                                      "OWNER",
                                      "MANAGER",
                                      "CASHIER",
                                      "WAITER",
                                      "KITCHEN_STAFF",
                                      "INVENTORY_MANAGER"
                                    ]
                                  },
                                  "tenant": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "format": "uuid"
                                      },
                                      "name": {
                                        "type": "string"
                                      },
                                      "status": {
                                        "type": "string",
                                        "enum": [
                                          "ACTIVE",
                                          "SUSPENDED"
                                        ]
                                      },
                                      "currency": {
                                        "type": "string"
                                      },
                                      "branches": {
                                        "type": "array",
                                        "items": {
                                          "type": "object",
                                          "properties": {
                                            "id": {
                                              "type": "string",
                                              "format": "uuid"
                                            },
                                            "name": {
                                              "type": "string"
                                            },
                                            "timezone": {
                                              "type": "string"
                                            }
                                          },
                                          "required": [
                                            "id",
                                            "name",
                                            "timezone"
                                          ]
                                        }
                                      }
                                    },
                                    "required": [
                                      "id",
                                      "name",
                                      "status",
                                      "currency",
                                      "branches"
                                    ]
                                  },
                                  "branchAssignments": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "branchId": {
                                          "type": "string",
                                          "format": "uuid"
                                        }
                                      },
                                      "required": [
                                        "branchId"
                                      ]
                                    }
                                  }
                                },
                                "required": [
                                  "id",
                                  "role",
                                  "tenant",
                                  "branchAssignments"
                                ]
                              }
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "email",
                            "platformRole",
                            "isPlatformAdmin",
                            "memberships"
                          ]
                        }
                      },
                      "required": [
                        "user"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid registration input.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "nullable": true
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status",
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Account already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "nullable": true
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status",
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/{view}": {
      "get": {
        "summary": "Read a role-specific, access-scoped dashboard",
        "security": [
          {
            "accessCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "overview",
                "pos",
                "kitchen",
                "inventory",
                "admin"
              ]
            },
            "required": true,
            "name": "view",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "tenantId",
            "in": "query"
          },
          {
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "string",
                  "enum": [
                    "all"
                  ]
                }
              ]
            },
            "required": false,
            "name": "branchId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Role-specific dashboard data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "view": {
                          "type": "string",
                          "enum": [
                            "overview",
                            "pos",
                            "kitchen",
                            "inventory",
                            "admin"
                          ]
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "OWNER",
                            "MANAGER",
                            "CASHIER",
                            "WAITER",
                            "KITCHEN_STAFF",
                            "INVENTORY_MANAGER",
                            "PLATFORM_ADMIN"
                          ]
                        },
                        "tenant": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "name": {
                              "type": "string"
                            },
                            "currency": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "currency"
                          ]
                        },
                        "branches": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "name": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "name"
                            ]
                          }
                        },
                        "activeBranch": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "name": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "name"
                          ]
                        },
                        "permissions": {
                          "type": "object",
                          "properties": {
                            "reportsSalesRead": {
                              "type": "boolean"
                            },
                            "reportsProfitRead": {
                              "type": "boolean"
                            },
                            "staffRead": {
                              "type": "boolean"
                            },
                            "inventoryRead": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "reportsSalesRead",
                            "reportsProfitRead",
                            "staffRead",
                            "inventoryRead"
                          ]
                        },
                        "metrics": {
                          "type": "object",
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string"
                              },
                              {
                                "nullable": true
                              }
                            ]
                          }
                        },
                        "trend": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "day": {
                                "type": "number"
                              },
                              "sales": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "day",
                              "sales"
                            ]
                          }
                        },
                        "activity": {
                          "type": "array",
                          "items": {
                            "nullable": true
                          }
                        },
                        "dataStatus": {
                          "type": "string",
                          "enum": [
                            "NO_OPERATIONAL_DATA"
                          ]
                        },
                        "businessesList": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "name": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "ACTIVE",
                                  "SUSPENDED"
                                ]
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "status",
                              "createdAt"
                            ]
                          }
                        }
                      },
                      "required": [
                        "view",
                        "role",
                        "metrics"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "nullable": true
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status",
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The account is not permitted to read this dashboard or branch.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "nullable": true
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status",
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Sign in and create a cookie session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 320,
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 72
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; session cookies set.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "name": {
                              "type": "string"
                            },
                            "email": {
                              "type": "string",
                              "format": "email"
                            },
                            "platformRole": {
                              "type": "string",
                              "nullable": true,
                              "enum": [
                                "SUPER_ADMIN",
                                "SUPPORT_AGENT",
                                null
                              ]
                            },
                            "isPlatformAdmin": {
                              "type": "boolean"
                            },
                            "memberships": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "format": "uuid"
                                  },
                                  "role": {
                                    "type": "string",
                                    "enum": [
                                      "OWNER",
                                      "MANAGER",
                                      "CASHIER",
                                      "WAITER",
                                      "KITCHEN_STAFF",
                                      "INVENTORY_MANAGER"
                                    ]
                                  },
                                  "tenant": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "format": "uuid"
                                      },
                                      "name": {
                                        "type": "string"
                                      },
                                      "status": {
                                        "type": "string",
                                        "enum": [
                                          "ACTIVE",
                                          "SUSPENDED"
                                        ]
                                      },
                                      "currency": {
                                        "type": "string"
                                      },
                                      "branches": {
                                        "type": "array",
                                        "items": {
                                          "type": "object",
                                          "properties": {
                                            "id": {
                                              "type": "string",
                                              "format": "uuid"
                                            },
                                            "name": {
                                              "type": "string"
                                            },
                                            "timezone": {
                                              "type": "string"
                                            }
                                          },
                                          "required": [
                                            "id",
                                            "name",
                                            "timezone"
                                          ]
                                        }
                                      }
                                    },
                                    "required": [
                                      "id",
                                      "name",
                                      "status",
                                      "currency",
                                      "branches"
                                    ]
                                  },
                                  "branchAssignments": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "branchId": {
                                          "type": "string",
                                          "format": "uuid"
                                        }
                                      },
                                      "required": [
                                        "branchId"
                                      ]
                                    }
                                  }
                                },
                                "required": [
                                  "id",
                                  "role",
                                  "tenant",
                                  "branchAssignments"
                                ]
                              }
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "email",
                            "platformRole",
                            "isPlatformAdmin",
                            "memberships"
                          ]
                        }
                      },
                      "required": [
                        "user"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid login input.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "nullable": true
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status",
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Credentials are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "nullable": true
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status",
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate the refresh token",
        "responses": {
          "200": {
            "description": "Session refreshed; cookies rotated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "authenticated": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        }
                      },
                      "required": [
                        "authenticated"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Refresh token is invalid, expired, or reused.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "nullable": true
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status",
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoke the refresh-token family and clear cookies",
        "responses": {
          "200": {
            "description": "Signed out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "loggedOut": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        }
                      },
                      "required": [
                        "loggedOut"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "success"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Return the signed-in user and tenant memberships",
        "security": [
          {
            "accessCookie": []
