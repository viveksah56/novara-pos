enum BusinessRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
  INVENTORY_MANAGER
  @@schema("novara")
}

model Membership {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  userId             String              @db.Uuid
  role               BusinessRole
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchAssignments BranchAssignment[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, createdAt])
  @@index([tenantId, isActive, role])
  @@schema("novara")
}

model BranchAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  membershipId String     @db.Uuid
  branchId     String     @db.Uuid
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  branch       Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([membershipId, branchId])
  @@index([tenantId, branchId])
  @@schema("novara")
}
