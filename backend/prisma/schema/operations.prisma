enum MeasureUnit {
  EACH
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  OUNCE
  POUND
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE_RECEIVED
  WASTE
  ADJUSTMENT
  RECIPE_USAGE
}

enum SalesOrderStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum KitchenOrderStatus {
  PENDING
  PREPARING
  READY
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String    @db.VarChar(100)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive, sortOrder])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  categoryId  String?  @db.Uuid
  name        String   @db.VarChar(160)
  description String?  @db.VarChar(1000)
  sku         String?  @db.VarChar(80)
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipe      Recipe?
  orderItems  SalesOrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId, isAvailable])
  @@index([tenantId, name])
}

model Ingredient {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  name         String              @db.VarChar(160)
  unit         MeasureUnit
  unitCost     Decimal?            @db.Decimal(10, 4)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeLines  RecipeIngredient[]
  stockLevels  StockLevel[]
  purchaseLines PurchaseItem[]
  movements    StockMovement[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive, name])
}

model Recipe {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @db.Uuid
  productId String              @unique @db.Uuid
  notes     String?             @db.VarChar(1000)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([tenantId, updatedAt])
}

model RecipeIngredient {
  id           String     @id @default(uuid()) @db.Uuid
  recipeId     String     @db.Uuid
  ingredientId String     @db.Uuid
  quantity     Decimal    @db.Decimal(12, 3)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  name      String     @db.VarChar(160)
  email     String?    @db.VarChar(320)
  phone     String?    @db.VarChar(40)
  address   String?    @db.VarChar(500)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive, name])
}

model StockLevel {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  branchId      String     @db.Uuid
  ingredientId  String     @db.Uuid
  quantity      Decimal    @default(0) @db.Decimal(12, 3)
  reorderLevel  Decimal    @default(0) @db.Decimal(12, 3)
  updatedAt     DateTime   @updatedAt
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([branchId, ingredientId])
  @@index([tenantId, branchId, quantity])
}

model Purchase {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  branchId    String         @db.Uuid
  supplierId  String         @db.Uuid
  status      PurchaseStatus @default(DRAFT)
  reference   String?        @db.VarChar(80)
  notes       String?        @db.VarChar(1000)
  totalAmount Decimal        @default(0) @db.Decimal(12, 2)
  orderedAt   DateTime?
  receivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items       PurchaseItem[]
  stockMovements StockMovement[]

  @@index([tenantId, branchId, status, createdAt])
  @@index([supplierId, createdAt])
}

model PurchaseItem {
  id           String     @id @default(uuid()) @db.Uuid
  purchaseId   String     @db.Uuid
  ingredientId String     @db.Uuid
  quantity     Decimal    @db.Decimal(12, 3)
  unitCost     Decimal    @db.Decimal(10, 2)
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, ingredientId])
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  branchId     String            @db.Uuid
  ingredientId String            @db.Uuid
  purchaseId   String?           @db.Uuid
  salesOrderId String?           @db.Uuid
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  note         String?           @db.VarChar(500)
  createdById  String            @db.Uuid
  createdAt    DateTime          @default(now())
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  purchase     Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  salesOrder   SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, createdAt])
  @@index([ingredientId, createdAt])
  @@index([salesOrderId])
}

model SalesOrder {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  branchId    String            @db.Uuid
  createdById String            @db.Uuid
  status      SalesOrderStatus  @default(OPEN)
  totalAmount Decimal           @default(0) @db.Decimal(12, 2)
  completedAt DateTime?
  kitchenStatus KitchenOrderStatus @default(PENDING)
  paymentMethod PaymentMethod?
  paidAmount Decimal? @db.Decimal(12, 2)
  cashReceived Decimal? @db.Decimal(12, 2)
  cashChange Decimal? @db.Decimal(12, 2)
  shiftId String? @db.Uuid
  clientOrderId String? @db.VarChar(80)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("SalesOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       SalesOrderItem[]
  shift       Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  movements   StockMovement[]

  @@index([tenantId, branchId, status, createdAt])
  @@unique([tenantId, clientOrderId])
  @@index([shiftId])
}

model SalesOrderItem {
  id          String     @id @default(uuid()) @db.Uuid
  orderId     String     @db.Uuid
  productId   String     @db.Uuid
  quantity    Decimal    @db.Decimal(12, 3)
  unitPrice   Decimal    @db.Decimal(10, 2)
  lineTotal   Decimal    @db.Decimal(12, 2)
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  branchId       String      @db.Uuid
  userId         String      @db.Uuid
  status         ShiftStatus @default(OPEN)
  openingCash    Decimal     @db.Decimal(12, 2)
  expectedCash   Decimal     @default(0) @db.Decimal(12, 2)
  closingCash    Decimal?    @db.Decimal(12, 2)
  cashVariance   Decimal?    @db.Decimal(12, 2)
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  note           String?     @db.VarChar(500)
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders         SalesOrder[]

  @@index([tenantId, branchId, status, openedAt])
  @@index([userId, branchId, closedAt])
}
