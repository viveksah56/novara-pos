model TeamInvitation {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @db.Uuid
  email       String                 @db.VarChar(320)
  role        BusinessRole
  tokenHash   String                 @unique @db.VarChar(64)
  invitedById String                 @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime               @default(now())
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy   User                   @relation("TeamInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  branches    TeamInvitationBranch[]

  @@index([tenantId, email, createdAt])
  @@index([tenantId, revokedAt, acceptedAt, expiresAt])
  @@schema("novara_database")
}

model TeamInvitationBranch {
  id           String        @id @default(uuid()) @db.Uuid
  invitationId String        @db.Uuid
  branchId     String        @db.Uuid
  createdAt    DateTime      @default(now())
  invitation   TeamInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([invitationId, branchId])
  @@index([branchId])
  @@schema("novara_database")
}
