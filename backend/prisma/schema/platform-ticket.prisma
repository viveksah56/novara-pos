enum PlatformTicketType {
  COMPLAINT
  FEEDBACK
  SUPPORT
  @@schema("novara_database")
}

enum PlatformTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  @@schema("novara_database")
}

enum PlatformTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  @@schema("novara_database")
}

model PlatformTicket {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String?                @db.Uuid
  createdById    String                 @db.Uuid
  assignedStaffId String?               @db.Uuid
  type           PlatformTicketType
  priority       PlatformTicketPriority @default(NORMAL)
  status         PlatformTicketStatus   @default(OPEN)
  subject        String                 @db.VarChar(160)
  message        String                 @db.VarChar(5000)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy      User                   @relation("TicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedStaff  PlatformStaff?         @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([tenantId, createdAt])
  @@index([createdById, createdAt])
  @@schema("novara_database")
}
